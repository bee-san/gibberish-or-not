--- /dev/null
+++ b/examples/gon_baselines.rs
@@ -0,0 +1,109 @@
+//! Scratch (gib-lead, never pushed): baseline verdicts for gibberish-or-not's benchmark corpus.
+//!
+//! Reads `id<TAB>text` lines (text with \t \n \r \\ \xHH \uHHHH escaped) on stdin and writes, per line,
+//! `id<TAB>gon507_low<TAB>gon507_medium<TAB>gon507_high<TAB>english_low<TAB>english_medium<TAB>english_high<TAB>ns_gon507_medium<TAB>ns_english_medium`
+//! where 1 means "accepted as language" (`!is_gibberish` for gibberish-or-not 5.0.7, and
+//! `EnglishChecker::check(..).is_identified`, the English checker as Ciphey uses it today).
+//! Timings are nanoseconds per check, repeated for checks under 2 µs (as benches/plaintext.rs).
+//!
+//! cargo run --release --example gon_baselines < ids_and_texts.tsv > verdicts.tsv
+
+use std::hint::black_box;
+use std::io::{BufRead, Write};
+use std::time::{Duration, Instant};
+
+use ciphey::checkers::{
+    checker_type::{Check, Checker},
+    english::EnglishChecker,
+};
+use gibberish_or_not::{is_gibberish, Sensitivity};
+
+fn unescape(field: &str) -> String {
+    let mut out = String::with_capacity(field.len());
+    let mut chars = field.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('x') => {
+                let hex: String = chars.by_ref().take(2).collect();
+                out.push(char::from_u32(u32::from_str_radix(&hex, 16).unwrap_or(0xFFFD)).unwrap_or('\u{FFFD}'));
+            }
+            Some('u') => {
+                let hex: String = chars.by_ref().take(4).collect();
+                out.push(char::from_u32(u32::from_str_radix(&hex, 16).unwrap_or(0xFFFD)).unwrap_or('\u{FFFD}'));
+            }
+            Some('t') => out.push('\t'),
+            Some('n') => out.push('\n'),
+            Some('r') => out.push('\r'),
+            Some('\\') => out.push('\\'),
+            Some(other) => {
+                out.push('\\');
+                out.push(other);
+            }
+            None => out.push('\\'),
+        }
+    }
+    out
+}
+
+fn timed(check: &dyn Fn(&str) -> bool, text: &str) -> (bool, f64) {
+    let t0 = Instant::now();
+    let hit = check(black_box(text));
+    let first = t0.elapsed();
+    if first >= Duration::from_micros(2) {
+        return (hit, first.as_nanos() as f64);
+    }
+    let reps = (2_000 / first.as_nanos().max(1)).clamp(2, 256) as u32;
+    let t1 = Instant::now();
+    for _ in 0..reps {
+        black_box(check(black_box(text)));
+    }
+    (hit, t1.elapsed().as_nanos() as f64 / f64::from(reps))
+}
+
+fn main() {
+    let sens = [Sensitivity::Low, Sensitivity::Medium, Sensitivity::High];
+    let english: Vec<Checker<EnglishChecker>> = sens
+        .iter()
+        .map(|&s| Checker::<EnglishChecker>::new().with_sensitivity(s))
+        .collect();
+    let lines: Vec<(String, String)> = std::io::stdin()
+        .lock()
+        .lines()
+        .map_while(Result::ok)
+        .filter_map(|l| {
+            let (id, text) = l.split_once('\t')?;
+            Some((id.to_string(), unescape(text)))
+        })
+        .collect();
+    // Warm up lazily built tables
+    for (_, t) in lines.iter().take(200) {
+        black_box(is_gibberish(t, Sensitivity::Medium));
+        black_box(english[1].check(t).is_identified);
+    }
+    let gon_medium = |t: &str| !is_gibberish(t, Sensitivity::Medium);
+    let english_medium = |t: &str| english[1].check(t).is_identified;
+    let stdout = std::io::stdout();
+    let mut out = std::io::BufWriter::new(stdout.lock());
+    for (id, text) in &lines {
+        let g: Vec<u8> = sens
+            .iter()
+            .map(|&s| u8::from(!is_gibberish(text, s)))
+            .collect();
+        let e: Vec<u8> = english
+            .iter()
+            .map(|c| u8::from(c.check(text).is_identified))
+            .collect();
+        let (_, ns_g) = timed(&gon_medium, text);
+        let (_, ns_e) = timed(&english_medium, text);
+        writeln!(
+            out,
+            "{id}\t{}\t{}\t{}\t{}\t{}\t{}\t{ns_g:.0}\t{ns_e:.0}",
+            g[0], g[1], g[2], e[0], e[1], e[2]
+        )
+        .unwrap();
+    }
+}
